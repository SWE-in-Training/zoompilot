Import('env', 'arch', 'common', 'messaging')

if arch != "Darwin":
  pandad_env = env.Clone()

  # Prefer the vendored comma-deps-libusb, which AGNOS carries in its own venv,
  # and otherwise fall back to the system libusb the way pandad did before the
  # USB transport was removed. comma-deps-libusb is only a tools extra here, so
  # a plain `uv sync` does not have it.
  #
  # Not just ImportError: there is an unrelated package on PyPI also called
  # libusb, and it imports fine but has no INCLUDE_DIR. SConstruct turns SCons
  # warnings into exceptions and does not swallow them while reading an
  # SConscript, so letting that AttributeError out kills the whole build.
  try:
    import libusb
    pandad_env['CPPPATH'] += [libusb.INCLUDE_DIR]
    pandad_env['LIBPATH'] += [libusb.LIB_DIR]
  except Exception:
    pass

  libs = [common, messaging, 'pthread', 'usb-1.0']
  panda = pandad_env.Library('panda', ['panda.cc', 'spi.cc', 'usb.cc'])

  pandad_env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

  if GetOption('extras'):
    pandad_env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs)
